# Docker Compose (pilot) — copy to .env and set IMAGE before `docker compose up -d`
IMAGE=ghcr.io/europeanresolve/er-calendar-bridge:0.1.1

# mailbox.org CalDAV (read-only — enforced in Phase 3; never write to source)
MAILBOX_CALDAV_URL=https://dav.mailbox.org
# Per-calendar collection URL from mailbox.org calendar properties (not server root only)
MAILBOX_CALENDAR_URL=https://dav.mailbox.org/caldav/your-calendar-id/
MAILBOX_USERNAME=operator@example.org
# MAILBOX_APP_PASSWORD — create secrets/operator/mailbox_app_password (gitignored)

# Google Calendar API (OAuth — calendar scope only)
# GOOGLE_CLIENT_ID — secrets/operator/google_client_id
# GOOGLE_CLIENT_SECRET — secrets/operator/google_client_secret
# GOOGLE_REFRESH_TOKEN — secrets/operator/google_refresh_token
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Microsoft Graph (calendar scope only)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# SMTP (withhold notifications — Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASSWORD — secrets/operator/smtp_password when using compose.notify.yaml
SMTP_FROM=noreply@example.org
# Optional — unset disables owner withhold email (D-05)
# NOTIFY_OWNER_EMAIL=owner@example.org
# Optional internal doc link for tag guidance in notify template (D-12)
# TAG_GUIDANCE_URL=https://docs.example.org/er-tags

# Runtime
LOG_LEVEL=info
# Sync poll interval (seconds); default 300 (~5 minutes)
SYNC_INTERVAL_SECONDS=300
# SQLite mapping store (optional — default ./data/bridge.db under DATA_DIR)
# SQLITE_PATH=./data/bridge.db
# Host CLI default; Compose sets DATA_DIR=/data via compose.yaml environment
DATA_DIR=./data
